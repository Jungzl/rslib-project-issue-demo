{
  "name": "rslib-project",
  "version": "1.0.0",
  "packageManager": "pnpm@10.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/lib/index.d.cts",
        "default": "./dist/lib/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/lib/index.cjs",
  "module": "dist/es/index.js",
  "types": "dist/lib/index.d.cts",
  "files": ["dist"],
  "scripts": {
    "dev": "rslib build --watch",
    "build": "rslib build",
    "check": "biome check --write",
    "format": "biome format --write",
    "lint": "eslint .",
    "test": "vitest",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.2",
    "@biomejs/biome": "^1.9.3",
    "@eslint/js": "^9.18.0",
    "@rslib/core": "^0.3.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "core-js"]
  }
}
